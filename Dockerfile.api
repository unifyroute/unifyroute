# =============================================================================
# UnifyRoute API — Multi-stage build with uv
# =============================================================================

# ── Base stage ─────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS base

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── Install dependencies (layer caching) ───────────────────────────────────────
FROM base AS deps

COPY pyproject.toml uv.lock ./
COPY shared/pyproject.toml shared/
COPY brain/pyproject.toml brain/
COPY router/pyproject.toml router/
COPY api-gateway/pyproject.toml api-gateway/
COPY credential-vault/pyproject.toml credential-vault/
COPY quota-poller/pyproject.toml quota-poller/
COPY launcher/pyproject.toml launcher/
COPY selfheal/pyproject.toml selfheal/

RUN uv sync --frozen --no-dev --no-install-project

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM deps AS runtime

COPY . .

# Install the workspace packages (editable)
RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/app/shared/src:/app/router/src

# Default: api-gateway
CMD ["uv", "run", "uvicorn", "api_gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
